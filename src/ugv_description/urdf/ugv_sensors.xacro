<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- IMU -->
    <link name="imu_link"/>

    <joint name = "imu_joint" type = "fixed">
      <parent link = "base_link"/>
      <child link = "imu_link"/>
      <origin xyz="0 0 ${body_h/2}"/>
    </joint>

    <gazebo reference = "imu_link">
      <sensor name = "imu" type = "imu">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <topic>imu</topic>
        <gz_frame_id>imu_link</gz_frame_id>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </gazebo>

<!-- 360 Lidar -->
    <xacro:property name="lidar_r" value="0.028"/>
    <xacro:property name="lidar_h" value="0.04"/>

    <link name = "lidar_link">
        <visual>
            <geometry>
                <cylinder radius="${lidar_r}" length="${lidar_h}"/>
            </geometry>
        </visual>
    </link>

    <joint name = "lidar_joint" type = "fixed">
        <parent link = "base_link"/>
        <child link = "lidar_link"/>
        <origin xyz="0 0 ${body_h/2 + lidar_h/2}"/>
    </joint>

    <gazebo reference="lidar_link">
        <sensor name="lidar" type="gpu_lidar">
            <always_on>1</always_on>
            <update_rate>10</update_rate>
            <topic>scan</topic>
            <gz_frame_id>lidar_link</gz_frame_id>
            <visualize>true</visualize>
            <lidar>
            <scan>
                <horizontal>
                <samples>500</samples>
                <resolution>1</resolution>
                <min_angle>${-pi}</min_angle>
                <max_angle>${pi}</max_angle>
                </horizontal>
            </scan>
            <range>
                <min>0.05</min>
                <max>12</max>
                <resolution>0.01</resolution>
            </range>
            <noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise>
            </lidar>
        </sensor>
    </gazebo>

<!-- Cameras -->
    <xacro:macro name="cam" params="name x y z yaw">
    <link name="${name}_link">
        <visual><geometry><box size="0.012 0.025 0.024"/></geometry></visual>
    </link>
    <joint name="${name}_joint" type="fixed">
        <parent link = "base_link"/>
        <child link = "${name}_link"/>
        <origin xyz="${x} ${y} ${z}" rpy = "0 0 ${yaw}"/>
    </joint>
    <link name="${name}_optical_link"/>
    <joint name="${name}_optical_joint" type="fixed">
        <parent link = "${name}_link"/>
        <child link = "${name}_optical_link"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
        
    </joint>


    <gazebo reference="${name}_link">
        <sensor name="${name}" type="camera">
            <always_on>1</always_on>
            <update_rate>15</update_rate>
            <topic>${name}/image_raw</topic>
            <gz_frame_id>${name}_optical_link</gz_frame_id>
            <camera>
            <horizontal_fov>1.780236</horizontal_fov>
            <image>
                <width>640</width>
                <height>360</height>
                <format>R8G8B8</format>
            </image>
            <clip>
                <near>0.05</near>
                <far>50</far>
            </clip>
            <noise type="gaussian"><mean>0</mean><stddev>0.007</stddev></noise>
            </camera>
        </sensor>
    </gazebo>
    </xacro:macro>


    
    <xacro:cam name="front_cam"
           x="${body_l/2 + 0.012/2}"
           y="0"
           z="${body_h/2 - 0.024/2}"
           yaw="0"/>

    <xacro:cam name="rear_cam"
           x="${-body_l/2 - 0.012/2}"
           y="0"
           z="${body_h/2 - 0.024/2}"
           yaw="${pi}"/>

</robot>