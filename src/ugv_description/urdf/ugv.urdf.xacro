<?xml version="1.0"?>
<robot name="ugv" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Body from chassis.obj (inches in CAD). Wheels from ME 2026-11-24. Meters, kg. -->
  <xacro:property name="body_l" value="0.56"/>
  <xacro:property name="body_w" value="0.41"/>
  <xacro:property name="body_h" value="0.33"/>
  <xacro:property name="body_m" value="15.0"/>
  <xacro:property name="wheel_r" value="0.0635"/>        <!-- 5 in diameter (ME) -->
  <xacro:property name="wheel_outer_w" value="0.508"/>  <!-- 20 in, outside of left wheel to outside of right wheel (ME) -->
  <xacro:property name="wheel_w" value="${wheel_outer_w/2 - body_w/2}"/>  <!-- 0.049: assumes wheels sit right against the body sides -->
  <xacro:property name="wheel_m" value="1.0"/>
  <xacro:property name="wheel_x_spacing" value="0.22"/>  <!-- front/rear wheel distance from center. TODO: estimate, ask ME -->
  <xacro:property name="ground_clearance" value="0.05"/> <!-- ground to body bottom. TODO: estimate, ask ME -->
  <xacro:property name="wheel_z" value="${wheel_r - ground_clearance - body_h/2}"/>  <!-- axle relative to base_link (-0.1515) -->
  
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${-wheel_z + wheel_r}"/>   <!-- 0.215: base_link above the ground -->
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="-0.066 0 -0.164" rpy="${pi/2} 0 ${pi}"/>
      <geometry>
        <mesh filename="package://ugv_description/meshes/chassis.obj"/>
      </geometry>
    </visual>
    <collision>
        <geometry>
            <box size="${body_l} ${body_w} ${body_h}"/>
        </geometry>
    </collision>
    <inertial>
      <mass value="${body_m}"/>
      <inertia ixx="${body_m/12*(body_w**2 + body_h**2)}" ixy="0" ixz="0"
               iyy="${body_m/12*(body_l**2 + body_h**2)}" iyz="0"
               izz="${body_m/12*(body_l**2 + body_w**2)}"/>
    </inertial>
  </link>

    <xacro:macro name="track_wheel" params="name x y">
    <link name="${name}">
      <visual>
        <origin rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_r}" length="${wheel_w}"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="${pi/2} 0 0"/>
        <geometry>
            <cylinder radius="${wheel_r}" length = "${wheel_w}"/>
        </geometry>
      </collision>
      <inertial>
        <origin rpy="${pi/2} 0 0"/>
        <mass value="${wheel_m}"/>
        <!-- Solid cylinder (axis = its own z): ixx = iyy = m/12*(3r² + w²), izz = m*r²/2 -->
        <inertia ixx="${wheel_m/12*(3*(wheel_r**2)+wheel_w**2)}" ixy="0" ixz="0"
                 iyy="${wheel_m/12*(3*(wheel_r**2)+wheel_w**2)}" iyz="0"
                 izz="${wheel_m*(wheel_r**2)/2}"/>
      </inertial>
    </link>

    

    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${wheel_z}"/>
      <axis xyz="0 1 0"/>  <!-- which axis does a wheel spin around? -->
    </joint>
  </xacro:macro>

    <xacro:track_wheel name="left_wheel_front" x="${wheel_x_spacing}" y="${body_w/2 + wheel_w/2}"/>
    <xacro:track_wheel name="left_wheel_rear" x="${-wheel_x_spacing}" y="${body_w/2 + wheel_w/2}"/>
    <xacro:track_wheel name="left_wheel_middle" x="0" y="${body_w/2 + wheel_w/2}"/>
    <xacro:track_wheel name="right_wheel_middle" x="0" y="${-body_w/2 - wheel_w/2}"/>
    <xacro:track_wheel name="right_wheel_front" x="${wheel_x_spacing}" y="${-body_w/2 - wheel_w/2}"/>
    <xacro:track_wheel name="right_wheel_rear" x="${-wheel_x_spacing}" y="${-body_w/2 - wheel_w/2}"/>

    <gazebo>
      <plugin filename="gz-sim-diff-drive-system"
              name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_front_joint</left_joint>
        <left_joint>left_wheel_middle_joint</left_joint>
        <left_joint>left_wheel_rear_joint</left_joint>
        <right_joint>right_wheel_front_joint</right_joint>
        <right_joint>right_wheel_middle_joint</right_joint>
        <right_joint>right_wheel_rear_joint</right_joint>
        <wheel_separation>${body_w+wheel_w}</wheel_separation>
        <wheel_radius>${wheel_r}</wheel_radius>
        <topic>cmd_vel</topic>
        <odom_topic>odom</odom_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>
      </plugin>
    </gazebo>

    <gazebo>
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <topic>/joint_states</topic>
      </plugin>
    </gazebo>

    <xacro:include filename="$(find ugv_description)/urdf/ugv_sensors.xacro"/>
</robot>